# Home24 bot — пример .env. Секретов здесь нет: значения берите из своего хранилища паролей.
# Копия: cp .env.example .env  (Windows: copy .env.example .env)

# --- Telegram (my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
ADMIN_USER_IDS=

# --- Бренд и ссылки (как в script.md) ---
BRAND_NAME=Home24
SITE_URL=https://home24.msk.ru/
LOYALTY_URL=https://home24.msk.ru/loyalty
CHANNEL_URL=https://t.me/home24_msk
VK_URL=https://vk.ru/club172662058
SCRIPT_PATH=script.md

# --- ИИ ---
USE_AI=1
SMART_BOT=1

# RAG grounding (антигаллюцинации): факты из script.md / FAQ / карты / policy.
# RAG_OFF=1 — выключить. По умолчанию включено.
# RAG_TOP_K=6
# RAG_MAX_CHARS=1600
# Идеальный менеджер (эталонный диалог + тон): IDEAL_MANAGER_OFF=1 чтобы выкл.
# IDEAL_STYLE_OFF=1 — не подмешивать похожие живые реплики.

# Groq — первый в очереди, если ключ задан (GROQ_FIRST=0 — поставить в конец).
# Модель проверена в new-materials/home24_script_groq_audit.md.
# Бесплатный лимит ~8000 токенов/мин: при 429 Groq пропускается на 60 с, отвечает следующий ИИ.
GROQ_API_[REDACTED]
# GROQ_MODEL_SMART=
# GROQ_MODEL_EDGE=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_FIRST=1
# GROQ_REASONING_FORMAT=hidden

# Резерв: Mistral (AI1), Gemini (AI2), любой OpenAI-совместимый (AI3)
AI1_API_[REDACTED]
AI1_MODEL=ministral-8b-latest
AI2_API_[REDACTED]
AI2_MODEL=gemini-flash-lite-latest
AI3_API_[REDACTED]
AI3_MODEL=

# --- Рассылка (безопасный темп, v9.6) ---
DAILY_SEND_LIMIT=30
WEEKLY_SEND_LIMIT=210
OUTREACH_MAX_PER_HOUR=4
OUTREACH_MIN_GAP_SEC=240
WORK_HOURS_START=10
WORK_HOURS_END=20
WORK_TIMEZONE=Europe/Moscow

# --- Панель ---
DASHBOARD_HOST=[REDACTED]
DASHBOARD_PORT=
DASHBOARD_[REDACTED]
DASHBOARD_ADMIN_[REDACTED] --- amoCRM (сеть выключена, пока пусто) ---
AMOCRM_BASE_URL=
AMOCRM_[REDACTED]

# Цены из календаря TravelLine в ответе гостю (1 — показывать, 0 — цену называет менеджер, как в скрипте)
TRAVELLINE_PRICES=1
