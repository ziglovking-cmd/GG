[Unit]
Description=Home24 Telegram manager bot
After=network.target
[Service]
Type=simple
WorkingDirectory=/opt/home24/app
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/home24/app/.env
ExecStart=/opt/home24/venv/bin/python bot/main.py
Restart=always
RestartSec=5
MemoryMax=200M
[Install]
WantedBy=multi-user.target
